		// removed other assertion

		// 绕过将publicField+1的getter函数,直接读取publicField的原始值
		// removed other assertion
		// 先尝试getter函数, 成功则补不直接读取publicField
		// removed other assertion

		bean = new TestBean();
		// 无需setter函数, 直接设置privateField
		ReflectionUtil.setFieldValue(bean, ""privateField"", 2);
		// removed other assertion
