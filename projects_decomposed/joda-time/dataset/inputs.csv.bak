        YearMonth test = base.withChronologyRetainFields(COPTIC_TOKYO);
        assertSame(base,test);
    }",TestYearMonth_Basics::testWithChronologyRetainFields_sameChrono_1_oe,"public YearMonth withChronologyRetainFields(Chronology newChronology) {
        newChronology = DateTimeUtils.getChronology(newChronology);
        newChronology = newChronology.withUTC();
        if (newChronology == getChronology()) {
            return this;
        } else {
            YearMonth newYearMonth = new YearMonth(this, newChronology);
            newChronology.validate(newYearMonth, getValues());
            return newYearMonth;
        }
    }","/**
