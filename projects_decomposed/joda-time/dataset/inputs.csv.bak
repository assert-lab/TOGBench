joda_2989_1,"    public void testNearDstTransition_1_oe() {

        int hour = 23;
        DateTime dt;

        dt = new DateTime(2006, 10, 29, hour, 0, 0, 0,
                          ISOChronology.getInstance(DateTimeZone.forID(""America/Los_Angeles"")));
        assertEquals(hour,dt.getHourOfDay());// OK - no LenientChronology dt = new DateTime(2006,10,29,hour,0,0,0,LenientChronology.getInstance(ISOChronology.getInstance(DateTimeZone.forOffsetHours(-8))));
    }",TestLenientChronology::testNearDstTransition_1_oe,"public int getHourOfDay() {
