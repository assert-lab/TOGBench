        assertEquals(expect,f.print(dt));
    }",TestDateTimeFormatStyle::testForStyle_mediumFullDateTime_1_oe,"public String print(ReadableInstant instant) {
        StringBuilder buf = new StringBuilder(requirePrinter().estimatePrintedLength());
