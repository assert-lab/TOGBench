        test = new DateTime(TEST_TIME1, PARIS);
        result = test.toCalendar(null);
        assertEquals(test.getMillis(),result.getTime().getTime());
    }",TestDateTime_Basics::testToCalendar_Locale_3_oe,"public long getMillis() {
        return iMillis;
    }","/**
