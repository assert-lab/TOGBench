joda_211_1,"    public void testOverlap_RInterval_zone_1_oe() {
        Interval testA = new Interval(new DateTime(3, LONDON), new DateTime(7, LONDON));
        assertEquals(ISOChronology.getInstance(LONDON),testA.getChronology());
    }",TestInterval_Basics::testOverlap_RInterval_zone_1_oe,"public static ISOChronology getInstance() {
