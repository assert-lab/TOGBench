        Converter[] array = new Converter[] {
            c1, c2, c3, c4,
        };
        ConverterSet set = new ConverterSet(array);
        try {
            set.remove(200, null);
        } catch (IndexOutOfBoundsException ex) {}
        assertEquals(4,set.size());
    }",TestConverterSet::testRemoveBadIndex1_2_oe,"int size() {
