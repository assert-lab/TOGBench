joda_2974_1,"    public void testFactory_Zone_int_1_oe() {
        GregorianChronology chrono = GregorianChronology.getInstance(TOKYO, 2);
        assertEquals(TOKYO,chrono.getZone());
    }",TestGregorianChronology::testFactory_Zone_int_1_oe,"public static final DateTimeZone getZone(DateTimeZone zone) {
        if (zone == null) {
            return DateTimeZone.getDefault();
        }
        return zone;
    }","/**
     * Gets the zone handling null.
     * <p>
     * If the zone is <code>null</code>, {@link DateTimeZone#getDefault()}
     * will be returned. Otherwise, the zone specified is returned.
     * 
     * @param zone  the time zone to use, null means the default zone
     * @return the time zone, never null
     */"
joda_2974_2,"    public void testFactory_Zone_int_2_oe() {
