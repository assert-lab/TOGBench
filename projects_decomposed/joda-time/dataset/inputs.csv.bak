        PreciseDateTimeField field = new MockPreciseDateTimeField();
        assertEquals(0,field.get(0));
    }",TestPreciseDateTimeField::test_get_1_oe,"@Override
    public int get(long instant) {
        if (instant >= 0) {
            return (int) ((instant / getUnitMillis()) % iRange);
        } else {
            return iRange - 1 + (int) (((instant + 1) / getUnitMillis()) % iRange);
        }
    }","/**
