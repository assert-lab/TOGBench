        expect = new DateTime(2000, 1, 3, 0, 0, 0, 0, DateTimeZone.UTC);

        expect = new DateTime(2098, 12, 29, 0, 0, 0, 0, DateTimeZone.UTC);

        f = new DateTimeFormatterBuilder().appendTwoDigitWeekyear(2000).toFormatter();
