joda_2880_1,"    public void testLeapYearRulesConstruction_1_oe() {
        DateMidnight dt = new DateMidnight(1500, 2, 29, GJChronology.getInstanceUTC());
        assertEquals(dt.getYear(),1500);
    }",TestGJChronology::testLeapYearRulesConstruction_1_oe,"public int getYear() {
