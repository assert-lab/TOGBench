        assertEquals(start,end.minusHours(22));
    }",TestISOChronology::testTimeOfDayAdd_2_oe,"public TimeOfDay minusHours(int hours) {
        return withFieldAdded(DurationFieldType.hours(), FieldUtils.safeNegate(hours));
    }","/**
