        DateTime dt = new DateTime(2004, 6, 9, 10, 20, 30, 40, UTC);
        DateTimeFormatter f = DateTimeFormat.forPattern(""YY"").withLocale(Locale.UK);
        
        dt = new DateTime(-123, 6, 9, 10, 20, 30, 40, UTC);
        
