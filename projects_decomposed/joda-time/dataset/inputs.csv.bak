        try {
            test.toStandardDuration();
        } catch (UnsupportedOperationException ex) {}
        
        test = Period.years(-1);
        try {
            test.toStandardDuration();
        } catch (UnsupportedOperationException ex) {}
        
        test = Period.years(0);
        assertEquals(0,test.toStandardDuration().getMillis());
