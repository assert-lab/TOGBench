joda_4_1,"    public void testGetMethods_1_oe() {
        MutableDateTime test = new MutableDateTime();
        
        assertEquals(ISOChronology.getInstance(),test.getChronology());
    }",TestMutableDateTime_Basics::testGetMethods_1_oe,"public static ISOChronology getInstance() {
        return getInstance(DateTimeZone.getDefault());
    }","/**
     * Gets an instance of the ISOChronology in the default time zone.
     * 
     * @return a chronology in the default time zone
     */"
joda_4_2,"    public void testGetMethods_2_oe() {
        MutableDateTime test = new MutableDateTime();
        
        assertEquals(LONDON,test.getZone());
    }",TestMutableDateTime_Basics::testGetMethods_2_oe,"public static final DateTimeZone getZone(DateTimeZone zone) {
        if (zone == null) {
            return DateTimeZone.getDefault();
        }
        return zone;
    }","/**
     * Gets the zone handling null.
     * <p>
     * If the zone is <code>null</code>, {@link DateTimeZone#getDefault()}
     * will be returned. Otherwise, the zone specified is returned.
     * 
     * @param zone  the time zone to use, null means the default zone
     * @return the time zone, never null
     */"
joda_4_3,"    public void testGetMethods_3_oe() {
        MutableDateTime test = new MutableDateTime();
        
        assertEquals(TEST_TIME_NOW,test.getMillis());
    }",TestMutableDateTime_Basics::testGetMethods_3_oe,"public long getMillis() {
        return iMillis;
    }","/**
     * Gets the milliseconds of the instant.
     * 
     * @return the number of milliseconds since 1970-01-01T00:00:00Z
     */"
