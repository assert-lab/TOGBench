        values = new int[] {10, 20, 30, 40};
        expected = new int[] {10, 20, 31, 40};
        result = field.add(new TimeOfDay(), 2, values, 1);
        
        values = new int[] {10, 20, 30, 40};
        expected = new int[] {10, 21, 0, 40};
