        check(base, 2005, 6, 9);
        DateTime expected = new DateTime(2005, 6, 9, 12, 13, 14, 15, COPTIC_LONDON);
        assertEquals(expected,test);
    }",TestLocalDate_Basics::testToDateTime_LocalTime_1_oe,"public DateTime toDateTime(LocalTime time) {
