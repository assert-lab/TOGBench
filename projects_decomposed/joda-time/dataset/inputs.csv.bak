        f = f.withZoneUTC();
        DateTime expect = null;
        expect = new DateTime(2003, 12, 29, 0, 0, 0, 0, UTC);
        
        expect = new DateTime(1922, 1, 2, 0, 0, 0, 0, UTC);
        
