joda_3186_2,"    public void testAddNullRemoved1_2_oe() {
        Converter[] array = new Converter[] {
            c1, c2, c3, c4,
        };
        ConverterSet set = new ConverterSet(array);
        ConverterSet result = set.add(c5, null);
        assertEquals(5,result.size());
