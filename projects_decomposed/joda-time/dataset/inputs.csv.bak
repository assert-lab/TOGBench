",TestPeriodFormatterBuilder::testFormatAppend_PrinterParser_null_null_oe_101_oe,"public PeriodFormatterBuilder append(PeriodFormatter formatter) {
        if (formatter == null) {
            throw new IllegalArgumentException(""No formatter supplied"");
        }
        clearPrefix();
        append0(formatter.getPrinter(), formatter.getParser());
        return this;
    }","/**
     * Appends another formatter.
