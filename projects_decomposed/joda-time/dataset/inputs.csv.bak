joda_3727_1,"    public void testForStyle_mediumFullDateTime_1_oe() throws Exception {
        DateTimeFormatter f = DateTimeFormat.forStyle(""MF"");
        DateTime dt = new DateTime(2004, 6, 9, 10, 20, 30, 0);
