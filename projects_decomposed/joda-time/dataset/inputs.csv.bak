        DateTime end2 = new DateTime(2006, 6, 9, 12, 0, 9, 0, PARIS);
        
        assertEquals(3,Seconds.secondsBetween(start,end1).getSeconds());
    }",TestSeconds::testFactory_secondsBetween_RInstant_1_oe,"public static Seconds secondsBetween(ReadableInstant start, ReadableInstant end) {
