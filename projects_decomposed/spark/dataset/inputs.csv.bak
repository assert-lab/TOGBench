            {""/aaa/./bbb/"", ""/aaa/bbb/""},
            {""/aaa/../bbb/"", ""/bbb/""},
            {""/aaa/./../bbb/"", ""/bbb/""},
            {""/aaa/bbb/ccc/../../ddd/"", ""/aaa/ddd/""},
            {""./bbb/"", ""bbb/""},
            {""./aaa/../bbb/"", ""bbb/""},
            {""./"", """"},
            {"".//"", "".//""},
            {"".///"", "".///""},
            {""/."", ""/""},
            {""//."", ""//""},
            {""///."", ""///""},
            {""/"", ""/""},
            {""aaa/bbb"", ""aaa/bbb""},
            {""aaa/"", ""aaa/""},
            {""aaa"", ""aaa""},
            {""/aaa/bbb"", ""/aaa/bbb""},
            {""/aaa//bbb"", ""/aaa//bbb""},
            {""/aaa/./bbb"", ""/aaa/bbb""},
            {""/aaa/../bbb"", ""/bbb""},
            {""/aaa/./../bbb"", ""/bbb""},
            {""./bbb"", ""bbb""},
            {""./aaa/../bbb"", ""bbb""},
