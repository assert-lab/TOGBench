            {""./"", """"},
            {""."", """"},
            {"""", """"},
            {"".."", null},
            {""./.."", null},
            {""aaa/../.."", null},
            {""/foo/bar/../../.."", null},
            {""/../foo"", null},
            {""/foo/."", ""/foo/""},
            {""a"", ""a""},
            {""a/"", ""a/""},
            {""a/."", ""a/""},
            {""a/.."", """"},
            {""a/../.."", null},
            {""/foo/../../bar"", null},
            {""/foo/../bar//"", ""/bar//""},
        };

