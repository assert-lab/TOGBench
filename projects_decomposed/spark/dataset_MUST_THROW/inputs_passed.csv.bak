spark_255_101,"@Test
    public void testCreateSocketConnector_whenServerIsNull_thenThrowException_oe_101_oe() {
        try {
            SocketConnectorFactory.createSocketConnector(null, ""host"", 80);
            fail(""SocketConnector creation should have thrown an IllegalArgumentException"");
        } catch(IllegalArgumentException ex) {
        }
    }
",SocketConnectorFactoryTest::testCreateSocketConnector_whenServerIsNull_thenThrowException_oe_101_oe
