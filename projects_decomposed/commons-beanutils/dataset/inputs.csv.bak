bean_734_1,"    public void testSimpleConversion_1_oe() throws Exception {
        final String[] message= {
            ""from String"",
            ""from String"",
            ""from String"",
            ""from String"",
            ""from String"",
            ""from String"",
            ""from String"",
            ""from Byte"",
            ""from Short"",
            ""from Integer"",
            ""from Long"",
            ""from Float"",
            ""from Double""
        };

        final Object[] input = {
            String.valueOf(Integer.MIN_VALUE),
            ""-17"",
            ""-1"",
            ""0"",
            ""1"",
            ""17"",
            String.valueOf(Integer.MAX_VALUE),
            new Byte((byte)7),
            new Short((short)8),
            new Integer(9),
            new Long(10),
            new Float(11.1),
            new Double(12.2)
        };

        final Integer[] expected = {
            new Integer(Integer.MIN_VALUE),
            new Integer(-17),
            new Integer(-1),
            new Integer(0),
            new Integer(1),
            new Integer(17),
            new Integer(Integer.MAX_VALUE),
            new Integer(7),
            new Integer(8),
            new Integer(9),
            new Integer(10),
            new Integer(11),
            new Integer(12)
        };

        for(int i=0;i<expected.length;i++) {
            assertEquals(message[i] + "" to Integer"",expected[i],converter.convert(Integer.class,input[i]));
    }
    }
",IntegerConverterTestCase::testSimpleConversion_1_oe
