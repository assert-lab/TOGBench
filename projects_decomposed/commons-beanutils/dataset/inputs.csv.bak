bean_710_1,"    public void testSimpleConversion_1_oe() throws Exception {
        final String[] message= {
            ""from String"",
            ""from String"",
            ""from String"",
            ""from String"",
            ""from String"",
            ""from String"",
            ""from String"",
            ""from Byte"",
            ""from Short"",
            ""from Integer"",
            ""from Long"",
            ""from Float"",
            ""from Double""
        };

        final Object[] input = {
            String.valueOf(Double.MIN_VALUE),
            ""-17.2"",
            ""-1.1"",
            ""0.0"",
            ""1.1"",
            ""17.2"",
            String.valueOf(Double.MAX_VALUE),
            new Byte((byte)7),
            new Short((short)8),
            new Integer(9),
            new Long(10),
            new Float(11.1),
            new Double(12.2)
        };

        final Double[] expected = {
            new Double(Double.MIN_VALUE),
            new Double(-17.2),
            new Double(-1.1),
            new Double(0.0),
            new Double(1.1),
            new Double(17.2),
            new Double(Double.MAX_VALUE),
            new Double(7),
            new Double(8),
            new Double(9),
            new Double(10),
            new Double(11.1),
            new Double(12.2)
        };

        for(int i=0;i<expected.length;i++) {
            assertEquals(message[i] + "" to Double"",expected[i].doubleValue(),(converter.convert(Double.class,input[i])).doubleValue(),0.00001D);
    }
    }
",DoubleConverterTestCase::testSimpleConversion_1_oe
