        buffer.append(""], locale=["");
        buffer.append(locale);
        buffer.append(""]"");
        final MessageFormat mf = createMessageFormat(pattern, locale);
        ExtendedMessageFormat emf = null;
        if (locale == null) {
            emf = new ExtendedMessageFormat(pattern);
