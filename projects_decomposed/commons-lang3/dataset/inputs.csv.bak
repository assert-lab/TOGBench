                        + ""  owner=<null>,"" + BR
                        + ""  transactions="" + getClassPrefix(acc.transactions) + ""{"" + BR
                        + ""    "" + getClassPrefix(tx1) + ""["" + BR
                        + ""      amount=100.0,"" + BR
                        + ""      date=2014.10.14"" + BR
                        + ""    ],"" + BR
                        + ""    "" + getClassPrefix(tx2) + ""["" + BR
                        + ""      amount=50.0,"" + BR
                        + ""      date=2014.10.15"" + BR
                        + ""    ]"" + BR
                        + ""  }"" + BR
                        + ""]"";
