lang_1036_2,"    @Test
    public void textIndexesOfInt_2_oe() {
        int[] array = null;
        final BitSet emptySet = new BitSet();
        final BitSet testSet = new BitSet();
        array = new int[]{0, 1, 2, 3, 0};
        testSet.set(0);
        testSet.set(4);
        assertEquals(testSet, ArrayUtils.indexesOf(array, 0));
    }",ArrayUtilsTest::textIndexesOfInt_2_oe
lang_1036_3,"    @Test
    public void textIndexesOfInt_3_oe() {
        int[] array = null;
        final BitSet emptySet = new BitSet();
        final BitSet testSet = new BitSet();
        array = new int[]{0, 1, 2, 3, 0};
        testSet.set(0);
        testSet.set(4);
        testSet.clear();
        testSet.set(1);
