                .map(Integer::valueOf)
                .filter(i -> (i.intValue() %2 == 0))
                .collect(Collectors.toList());
                final List<Integer> output0 = output;
                for (int i0 = 0;  i0 < 3;  i0++) {
                    assertEquals((i0+1)*2, output0.get(i0).intValue());
    }
    }",StreamsTest::testSimpleStreamFilter_1_oe_2_oe
