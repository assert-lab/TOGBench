commons-numbers_529_101,"@Test
    void testRoundDouble_oe_101_oe() {
        try {
            Precision.round(1.234, 2, RoundingMode.UNNECESSARY);
            Assertions.fail();
        } catch (ArithmeticException ex) {
            // expected
        }
    }
",PrecisionTest::testRoundDouble_oe_101_oe
commons-numbers_568_101,"@Test
    void testGcd_oe_101_oe() {
        try {
            // gcd(Integer.MIN_VALUE, 0) > Integer.MAX_VALUE
            ArithmeticUtils.gcd(Integer.MIN_VALUE, 0);
            Assertions.fail(""expecting ArithmeticException"");
        } catch (ArithmeticException expected) {
            // expected
        }
    }
",ArithmeticUtilsTest::testGcd_oe_101_oe
