commons-numbers_571_101,"@Test
    void testLcm_oe_101_oe() {
        try {
            // lcm == abs(MIN_VALUE) cannot be represented as a nonnegative int
            ArithmeticUtils.lcm(Integer.MIN_VALUE, 1);
            Assertions.fail(""Expecting ArithmeticException"");
        } catch (ArithmeticException expected) {
            // expected
        }
    }
",ArithmeticUtilsTest::testLcm_oe_101_oe
commons-numbers_571_102,"@Test
    void testLcm_oe_102_oe() {
        try {
            // lcm == abs(MIN_VALUE) cannot be represented as a nonnegative int
            ArithmeticUtils.lcm(Integer.MIN_VALUE, 1 << 20);
            Assertions.fail(""Expecting ArithmeticException"");
        } catch (ArithmeticException expected) {
            // expected
        }
    }
",ArithmeticUtilsTest::testLcm_oe_102_oe
commons-numbers_571_103,"@Test
