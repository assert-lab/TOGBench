commons-jexl3_406_101,"@Test
    public void testForEachContinueBroken_oe_101_oe() throws Exception {
        try {
            final JexlScript e = JEXL.createScript(""var rr = 0; continue;"");
            Assert.fail(""continue is out of loop!"");
        } catch (final JexlException.Parsing xparse) {
            final String str = xparse.detailedMessage();
        }
    }
",ForEachTest::testForEachContinueBroken_oe_101_oe
