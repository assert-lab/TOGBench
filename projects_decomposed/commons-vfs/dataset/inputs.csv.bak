public interface FileName extends Comparable<FileName> {

    /**
The separator character used in file paths.
/
    char SEPARATOR_CHAR = '/';

    /**
The separator used in file paths.
/
    String SEPARATOR = ""/"";

    /**
The absolute path of the root of a file system.
/
    String ROOT_PATH = ""/"";

    /**
Empty array of FileName.

@since 2.8.0
/
    FileName[] EMPTY_ARRAY = new FileName[0];

    /**
Gets the base name of this file. The base name is the last element of the file name. For example the base name
