/
    public static final Duration DEFAULT_MIN_EVICTABLE_IDLE_DURATION =
            Duration.ofMillis(DEFAULT_MIN_EVICTABLE_IDLE_TIME_MILLIS);

    /**
The default value for the {@code minEvictableIdleDuration}
